# --- GiftLink frontend (Vite) ---
# Leave empty to call the API on the same origin (/api), proxied by Vite in dev and nginx in prod.
# Set only when the API lives on another origin, e.g. https://api.giftlink.example
VITE_BACKEND_URL=

# Where the Vite dev server proxies /api (dev only, not bundled)
VITE_PROXY_TARGET=http://localhost:3060
