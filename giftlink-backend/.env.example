# --- GiftLink backend configuration (copy to .env for local development) ---
NODE_ENV=development
PORT=3060
LOG_LEVEL=debug

# MongoDB connection (docker-compose exposes mongo on localhost:27017; password = MONGO_ROOT_PASSWORD in the root .env)
MONGO_URL=mongodb://root:CHANGE_ME@localhost:27017/?authSource=admin
MONGO_DB_NAME=giftdb

# JWT signing secret - at least 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=1h

# Optional sentiment microservice (comments are created without sentiment when unset/down)
SENTIMENT_URL=http://localhost:3000
SENTIMENT_TIMEOUT_MS=1500

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:9000

# Max requests per 15 minutes per IP on /api/auth/*
AUTH_RATE_LIMIT_MAX=100
