# --- GiftLink root configuration: read by docker compose, the Makefile and the k8s helpers ---
# Copy to .env (`make env`) and replace every CHANGE_ME value. .env is git-ignored: never commit it.
# Generate secrets with:  openssl rand -hex 32

# MongoDB root credentials (compose creates the root user on first start of an empty volume)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# JWT signing secret for the API (>= 16 chars; use 32+ random bytes outside local dev)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Non-secret settings (safe defaults)
MONGO_DB_NAME=giftdb
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:9000,http://localhost:5173

# Host ports
FRONTEND_PORT=9000
BACKEND_PORT=3060
SENTIMENT_PORT=3000
MONGO_PORT=27017

# --- Kubernetes / IBM Cloud deploy only (see docs/DEPLOYMENT.md) ---
# Container registry namespace; kept out of the repo because it identifies your cloud account.
REGISTRY_NAMESPACE=CHANGE_ME_your_registry_namespace
