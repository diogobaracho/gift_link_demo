# --- docker-compose overrides (copy to .env) ---
# Published host ports
FRONTEND_PORT=8080
BACKEND_PORT=3060
SENTIMENT_PORT=3000
MONGO_PORT=27017

# MongoDB root credentials (the backend connects with these)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example
MONGO_DB_NAME=giftdb

# Auth: always override for anything public. Generate with: openssl rand -hex 32
JWT_SECRET=local-demo-secret-change-me-0123456789
JWT_EXPIRES_IN=1h
AUTH_RATE_LIMIT_MAX=100

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
